{
  "name": "chess-academy",
  "private": true,
  "version": "1.0.0",
  "description": "Satranç Akademisi — Premium Interactive Chess Learning Platform (Web + macOS)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --bundles app && mkdir -p src-tauri/target/release/bundle/dmg && hdiutil create -volname 'Satranc Akademisi' -srcfolder 'src-tauri/target/release/bundle/macos/Satranc Akademisi.app' -ov -format UDZO 'src-tauri/target/release/bundle/dmg/Satranc Akademisi_1.0.0_aarch64.dmg'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@tauri-apps/api": "^2.2.0",
    "chess.js": "^1.0.0-beta.8",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-chessboard": "^4.7.2",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tauri-apps/cli": "^2.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "stockfish.js": "^10.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
